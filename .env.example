# ============================================================
# GossipGarden Backend — variables de entorno requeridas
# Copiar a .env y rellenar los valores antes de arrancar.
# ============================================================

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# --- Firebase ---
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com   # bucket de Firebase Storage (opcional)

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MQTT (opcional) ---
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SSL=true
MQTT_TOPIC=plantas/+/sensores
MQTT_KEEPALIVE=60

# --- Pipeline de identificación de plantas ---
PLANT_ID_API_KEY=
PLANT_ID_BASE_URL=https://plant.id/api/v3
PLANT_ID_DETAILS=common_names,taxonomy,url,gbif_id,inaturalist_id,watering,description
PLANT_ID_TIMEOUT_SECONDS=30

IDENT_CONFIDENCE_LOW=0.25
IDENT_CONFIDENCE_HIGH=0.75

GBIF_BASE_URL=https://api.gbif.org/v1
GBIF_TIMEOUT_SECONDS=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55
BOTANICAL_SOURCES_DIR=botanical_sources

LLM_DEFAULT_OUTPUT_LANGUAGE=es
